# NowAware Application Environment Configuration

# Operating Mode: "demo" (default local SQLite) or "aws" (DynamoDB, Bedrock, SES)
NOWAWARE_MODE=demo

# AWS Configuration (Required in 'aws' mode)
AWS_REGION=us-east-1
# AWS credentials resolution uses standard boto3 chain (environment, ~/.aws/credentials, or IAM Role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Amazon Bedrock Settings
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Amazon DynamoDB Table Names
DYNAMODB_RULES_TABLE=nowaware-monitoring-rules
DYNAMODB_SNAPSHOTS_TABLE=nowaware-source-snapshots
DYNAMODB_ALERTS_TABLE=nowaware-change-alerts

# Amazon SES Notification Settings
SES_SENDER_EMAIL=alerts@example.com
SES_RECIPIENT_OVERRIDE=

# Application & Monitoring Settings
DEFAULT_CHECK_INTERVAL_MINUTES=30
MIN_CHECK_INTERVAL_MINUTES=5
REQUEST_TIMEOUT_SECONDS=15
MAX_RESPONSE_BYTES=1048576  # 1MB limit for SSRF & DOS defense
LOCAL_DB_PATH=data/nowaware.db
LOG_LEVEL=INFO
